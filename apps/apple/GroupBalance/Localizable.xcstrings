    "Scan the QR code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-Code scannen"
          }
        }
      }
    },
    "Scan this on the other device. It joins as %@: it sees the group and writes as %@. It works once, so show it only to the person you mean.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne das auf dem anderen Gerät. Es tritt als %1$@ bei: Es sieht die Gruppe und schreibt als %2$@. Der Code funktioniert einmal, zeig ihn also nur der Person, die du meinst."
          }
        }
      }
    },
    "Search payments": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungen suchen"
          }
        }
      }
    },
    "Server": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        }
      }
    },
    "Servers you own": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Server"
          }
        }
      }
    },
    "Settle up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begleichen"
          }
        }
      }
    },
    "Settle up with %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %@ begleichen"
          }
        }
      }
    },
    "Settling records a payment. It counts once the receiver confirms it arrived.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begleichen trägt eine Zahlung ein. Sie zählt, sobald der Empfänger bestätigt, dass sie angekommen ist."
          }
        }
      }
    },
    "Share": {
      "localizations": {
        "de": {
