    "Split the amount over the people it arrives at. It only counts once they confirm it arrived.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteile den Betrag auf die Personen, bei denen er ankommt. Er zählt erst, wenn sie den Eingang bestätigen."
          }
        }
      }
    },
    "Split the amount over whom it belongs to. Empty means: same as above. Whoever gets more than they own passes the difference on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteile den Betrag darauf, wem er gehört. Leer heißt: so wie oben. Wer mehr bekommt, als ihm gehört, gibt den Unterschied weiter."
          }
        }
      }
    },
    "Still expected: %@. Record instalments one by one as they come in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch erwartet: %@. Trag Raten einzeln ein, sobald sie ankommen."
