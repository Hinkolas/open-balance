            "state": "translated",
            "value": "Teilen"
          }
        }
      }
    },
    "Show all": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anzeigen"
          }
        }
      }
    },
    "Someone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand"
          }
        }
      }
    },
    "Someone already joined as this member.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dieses Mitglied ist schon jemand beigetreten."
          }
        }
      }
    },
    "Split equally.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichmäßig verteilt."
