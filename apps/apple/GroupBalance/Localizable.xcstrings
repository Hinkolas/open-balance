          "stringUnit" : {
            "state" : "translated",
            "value" : "an %@"
          }
        }
      }
    },
    "To join, ask the group's admin to add you and show you your invite QR code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Beitreten: Bitte den Admin der Gruppe, dich hinzuzufügen und dir deinen Einladungs-QR-Code zu zeigen."
          }
        }
      }
    },
    "to you" : {
      "localizations" : {
