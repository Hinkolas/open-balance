    "What arrived?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist angekommen?"
          }
        }
      }
    },
    "What for? e.g. Dinner" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wofür? z. B. Abendessen"
