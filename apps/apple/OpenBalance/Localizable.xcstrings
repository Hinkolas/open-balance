        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere dein Wiederherstellungs-Kit"
          }
        }
      }
    },
    "Scan the QR code" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-Code scannen"
          }
        }
      }
    },
    "Scan this on the other device. It joins as %@: it sees the group and writes as %@. It works once, so show it only to the person you mean." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne das auf dem anderen Gerät. Es tritt als %1$@ bei: Es sieht die Gruppe und schreibt als %2$@. Der Code funktioniert einmal, zeig ihn also nur der Person, die du meinst."
          }
        }
      }
    },
    "Server" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server"
          }
        }
      }
    },
    "Servers you own" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Server"
          }
        }
      }
    },
    "Settle up" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begleichen"
          }
        }
      }
    },
    "Settling records a payment. It counts once the receiver confirms it arrived." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begleichen trägt eine Zahlung ein. Sie zählt, sobald der Empfänger bestätigt, dass sie angekommen ist."
          }
        }
      }
    },
    "Share" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilen"
          }
        }
      }
    },
    "Show" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzeigen"
          }
        }
      }
    },
    "Show a link that lets someone create a group on your server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Link anzeigen, mit dem jemand eine Gruppe auf deinem Server erstellen kann."
          }
        }
      }
    },
    "Show a QR code that lets another device write as you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen QR-Code anzeigen, mit dem ein anderes Gerät als du schreiben kann."
          }
        }
      }
    },
    "Show a recovery kit that makes a new device the admin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Wiederherstellungs-Kit anzeigen, das ein neues Gerät zum Admin macht."
          }
        }
      }
    },
    "Show all in History" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle in der Historie anzeigen"
          }
        }
      }
    },
    "Show an invite that lets someone join this group." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Einladung anzeigen, mit der jemand der Gruppe beitreten kann."
          }
        }
      }
    },
    "signature doesn't match the author" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signatur passt nicht zum Autor"
          }
        }
      }
    },
    "someone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "jemandem"
          }
        }
      }
    },
    "Someone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand"
          }
        }
      }
    },
    "Someone already joined as this member." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dieses Mitglied ist schon jemand beigetreten."
          }
        }
      }
    },
    "Split equally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleichmäßig verteilt."
          }
        }
      }
    },
    "Still expected" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch erwartet"
          }
        }
      }
    },
    "Still expected: %@. Confirm instalments one by one as they come in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch erwartet: %@. Bestätige Raten einzeln, sobald sie ankommen."
          }
        }
      }
    },
    "Syncing %lld change(s)…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiere %lld Änderung(en)…"
          }
        }
      }
    },
    "That is not a valid URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist keine gültige URL."
          }
        }
      }
    },
    "That QR code is not a Open Balance invite." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser QR-Code ist keine Open-Balance-Einladung."
          }
        }
      }
    },
    "The admin token is the server's ADMIN_TOKEN. It lets this device create groups there; it never gives access to any group's contents." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Admin-Token ist das ADMIN_TOKEN des Servers. Damit kann dieses Gerät dort Gruppen erstellen; Zugriff auf Inhalte einer Gruppe gibt es nie."
          }
        }
      }
    },
    "The current recovery kit stops working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das bisherige Kit funktioniert dann nicht mehr."
          }
        }
      }
    },
    "The faint bar shows where each balance lands once expected money arrives." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der blasse Balken zeigt, wo jeder Saldo landet, sobald das erwartete Geld angekommen ist."
          }
        }
      }
    },
    "The fewest transfers that settle everyone once all money has arrived." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die wenigsten Überweisungen, mit denen alle quitt sind, sobald alles Geld angekommen ist."
          }
        }
      }
    },
    "The group owes you money." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gruppe schuldet dir Geld."
          }
        }
      }
    },
    "The group stays on the server and with the other members. You can only come back with a new invite from the admin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gruppe bleibt auf dem Server und bei den anderen. Zurück kommst du nur mit einer neuen Einladung vom Admin."
          }
        }
      }
    },
    "The server owner invited you to create a group. You'll be its admin." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server-Betreiber hat dich eingeladen, eine Gruppe zu erstellen. Du wirst ihr Admin."
          }
        }
      }
    },
    "This device" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät"
          }
        }
      }
    },
    "This device was removed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät wurde entfernt"
          }
        }
      }
    },
    "This group" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gruppe"
          }
        }
      }
    },
    "This invite doesn't match a member of the group." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einladung passt zu keinem Mitglied der Gruppe."
          }
        }
      }
    },
    "This invite has already been used or was revoked. Ask for a new one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einladung wurde schon benutzt oder zurückgezogen. Bitte um eine neue."
          }
        }
      }
    },
    "This is the only time it's shown. This device doesn't keep it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wird nur jetzt angezeigt. Dieses Gerät speichert ihn nicht."
          }
        }
      }
    },
    "This link is not a valid Open Balance invite." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link ist keine gültige Open-Balance-Einladung."
          }
        }
      }
    },
    "This link to create a group has been used, withdrawn or has expired. Ask the server owner for a new one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Link zum Erstellen einer Gruppe wurde schon benutzt, zurückgezogen oder ist abgelaufen. Bitte den Server-Betreiber um einen neuen."
          }
        }
      }
    },
    "This recovery kit doesn't match the group's admin." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Wiederherstellungs-Kit passt nicht zum Admin der Gruppe."
          }
        }
      }
    },
    "This recovery kit no longer works. A newer one replaced it, or the group was deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Wiederherstellungs-Kit funktioniert nicht mehr. Ein neueres hat es ersetzt, oder die Gruppe wurde gelöscht."
          }
        }
      }
    },
    "This server doesn't speak protocol version 1." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server spricht Protokollversion 1 nicht."
          }
        }
      }
    },
    "To" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An"
          }
        }
      }
    },
    "to %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "an %@"
          }
        }
      }
    },
    "To join, ask the group's admin to add you and show you your invite QR code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Beitreten: Bitte den Admin der Gruppe, dich hinzuzufügen und dir deinen Einladungs-QR-Code zu zeigen."
          }
        }
      }
    },
    "To lock Balance with Face ID, touch and hold its icon on the Home Screen and choose Require Face ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Balance mit Face ID zu sperren, halte das App-Symbol auf dem Home-Bildschirm gedrückt und wähle „Face ID anfordern“."
          }
        }
      }
    },
    "to you" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "an dich"
          }
        }
      }
    },
    "Today" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute"
          }
        }
      }
    },
    "Total" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamt"
          }
        }
      }
    },
    "Two people edited this at the same time. The later edit won." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Personen haben das gleichzeitig bearbeitet. Die spätere Änderung gilt."
          }
        }
      }
    },
    "Type an amount or a percentage per person. It counts once they confirm it arrived." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib pro Person einen Betrag oder Prozente ein. Es zählt, sobald der Eingang bestätigt ist."
          }
        }
      }
    },
    "Type an amount or a percentage per person. Leave everything empty if it belongs to whoever received it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib pro Person einen Betrag oder Prozente ein. Lass alles leer, wenn es dem gehört, der es bekommen hat."
          }
        }
      }
    },
    "unknown author" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "unbekannter Autor"
          }
        }
      }
    },
    "Unknown date" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekanntes Datum"
          }
        }
      }
    },
    "Unknown event" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekannter Eintrag"
          }
        }
      }
    },
    "Unknown member" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekanntes Mitglied"
          }
        }
      }
    },
    "Unreadable event" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlesbarer Eintrag"
          }
        }
      }
    },
    "Use an amount or a percentage like 15%." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt sind Beträge oder Prozente wie 15%."
          }
        }
      }
    },
    "Waiting for arrival" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf Eingang"
          }
        }
      }
    },
    "What arrived?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist angekommen?"
          }
        }
      }
    },
    "What for? e.g. Dinner" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wofür? z. B. Abendessen"
          }
        }
      }
    },
    "What for? e.g. Project Nordlicht" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wofür? z. B. Projekt Nordlicht"
          }
        }
      }
    },
    "When the money is in your account, confirm it under Still expected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Geld auf deinem Konto ist, bestätige es unter „Noch erwartet“."
          }
        }
      }
    },
    "Who gets the money?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer bekommt das Geld?"
          }
        }
      }
    },
    "Who paid?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer hat bezahlt?"
          }
        }
      }
    },
    "Who pays whom" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer zahlt wem"
          }
        }
      }
    },
    "Who received what, whom it belongs to, what has arrived, and who pays whom. Only members can read it, not even the server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer was bekommen hat, wem es gehört, was angekommen ist und wer wem zahlt. Lesen können es nur Mitglieder, nicht einmal der Server."
          }
        }
      }
    },
    "Whom does it belong to?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wem gehört es?"
          }
        }
      }
    },
    "With a server's admin token this device can create groups there and let others create them. The token never gives access to any group's contents." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Admin-Token eines Servers kann dieses Gerät dort Gruppen erstellen und andere dort Gruppen erstellen lassen. Das Token gibt nie Zugriff auf die Inhalte einer Gruppe."
          }
        }
      }
    },
    "Yesterday" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestern"
          }
        }
      }
    },
    "you" : {
      "comment" : "After “by”, “from” or “at”. German: dir",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dir"
          }
        }
      }
    },
    "You" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du"
          }
        }
      }
    },
    "You become the admin on this device. The admin's other devices are removed from the group." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst auf diesem Gerät Admin. Die anderen Geräte des Admins werden aus der Gruppe entfernt."
          }
        }
      }
    },
    "You get" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst"
          }
        }
      }
    },
    "You join as the member this invite is for. Your key stays on this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trittst als das Mitglied bei, für das diese Einladung ist. Dein Schlüssel bleibt auf diesem Gerät."
          }
        }
      }
    },
    "You owe the group money." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du schuldest der Gruppe Geld."
          }
        }
      }
    },
    "You paid it all." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast alles bezahlt."
          }
        }
      }
    },
    "You pass on" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gibst weiter"
          }
        }
      }
    },
    "You pay" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du zahlst"
          }
        }
      }
    },
    "You receive" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst"
          }
        }
      }
    },
    "You'll get a QR code that lets only this person join, once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst einen QR-Code, mit dem nur diese Person einmal beitreten kann."
          }
        }
      }
    },
    "You're settled." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist quitt."
          }
        }
      }
    },
    "Your balance" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Saldo"
          }
        }
      }
    },
    "Your devices" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Geräte"
          }
        }
      }
    },
    "Your groups" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Gruppen"
          }
        }
      }
    },
    "Your name in the group" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Name in der Gruppe"
          }
        }
      }
    },
    "Yours" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dir gehört"
          }
        }
      }
    }
  },
  "version" : "1.0"
