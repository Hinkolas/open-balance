    },
    "Every amount in the group is in this currency. It can't be changed later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Beträge der Gruppe sind in dieser Währung. Sie lässt sich später nicht ändern."
