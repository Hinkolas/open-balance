{
  "description": "PROTOCOL.md §9.1: largest remainder. Products may exceed 64 bits.",
  "cases": [
    {
      "name": "exact",
      "total": 100,
      "weights": {
        "a": 1,
        "b": 1
      },
      "expect": {
        "a": 50,
        "b": 50
      }
    },
    {
      "name": "remainder to the larger remainder",
      "total": 100,
      "weights": {
        "a": 1,
        "b": 2
      },
      "expect": {
        "a": 33,
        "b": 67
      }
    },
    {
      "name": "tie to the smaller id",
      "total": 1,
      "weights": {
        "b": 1,
        "a": 1
      },
      "expect": {
        "b": 0,
        "a": 1
      }
    },
    {
      "name": "three way tie",
      "total": 2,
      "weights": {
        "c": 1,
        "b": 1,
        "a": 1
      },
      "expect": {
        "c": 0,
        "b": 1,
        "a": 1
      }
    },
    {
      "name": "zero weight gets nothing",
      "total": 7,
      "weights": {
        "a": 0,
        "b": 3,
        "c": 4
      },
      "expect": {
        "a": 0,
        "b": 3,
        "c": 4
      }
    },
    {
      "name": "zero total",
      "total": 0,
      "weights": {
        "a": 5,
        "b": 5
      },
      "expect": {
        "a": 0,
        "b": 0
      }
    },
    {
      "name": "product exceeds 64 bits",
      "total": 999999999999999,
      "weights": {
        "a": 999999999999999,
        "b": 1,
        "c": 333333333333333
      },
      "expect": {
        "a": 749999999999999,
        "b": 1,
        "c": 249999999999999
      }
    }
  ]
}
