{
  "description": "PROTOCOL.md §9.3: balances to transfers.",
  "cases": [
    {
      "name": "everyone settled",
      "balances": {
        "a": 0,
        "b": 0
      },
      "expect": []
    },
    {
      "name": "one debtor, one creditor",
      "balances": {
        "a": -500,
        "b": 500
      },
      "expect": [
        {
          "from": "a",
          "to": "b",
          "amount": 500
        }
      ]
    },
    {
      "name": "largest debtor pays largest creditor first",
      "balances": {
        "a": -500,
        "b": -300,
        "c": 200,
        "d": 600
      },
      "expect": [
        {
          "from": "a",
          "to": "d",
          "amount": 500
        },
        {
          "from": "b",
          "to": "c",
          "amount": 200
        },
        {
          "from": "b",
          "to": "d",
          "amount": 100
        }
      ]
    },
    {
      "name": "ties by member id",
      "balances": {
        "a": -100,
        "b": -100,
        "c": 100,
        "d": 100
      },
      "expect": [
        {
          "from": "a",
          "to": "c",
          "amount": 100
        },
        {
          "from": "b",
          "to": "d",
          "amount": 100
        }
      ]
    },
    {
      "name": "one creditor, many debtors",
      "balances": {
        "a": 900,
        "b": -300,
        "c": -300,
        "d": -300
      },
      "expect": [
        {
          "from": "b",
          "to": "a",
          "amount": 300
        },
        {
          "from": "c",
          "to": "a",
          "amount": 300
        },
        {
          "from": "d",
          "to": "a",
          "amount": 300
        }
      ]
    },
    {
      "name": "amounts near the limit",
      "balances": {
        "a": -1000000000000000,
        "b": 1000000000000000
      },
      "expect": [
        {
          "from": "a",
          "to": "b",
          "amount": 1000000000000000
        }
      ]
    }
  ]
}
